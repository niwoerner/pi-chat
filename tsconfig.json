{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"types": ["node"]
	},
	"include": ["daemon.ts", "types.ts", "src/**/*.ts", "types/**/*.d.ts"],
	"exclude": ["src/gondolin.ts", "src/tui", "src/render", "src/services"]
}
